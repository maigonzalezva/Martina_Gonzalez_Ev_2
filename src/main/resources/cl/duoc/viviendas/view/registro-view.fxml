<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.scene.control.*?>
        <?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cl.duoc.viviendas.controller.RegistroController"
      spacing="10" prefWidth="800" prefHeight="500">
    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

    <Label text="Registrar vivienda" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Tipo:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbTipo" onAction="#cambiarTipo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Código:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtCodigo" promptText="Ej: PROP-D01" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Superficie (m²):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtSuperficie" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Habitaciones:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtHabitaciones" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Piso:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPiso" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <CheckBox fx:id="chkGastoComun" text="Gasto común al día" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        <CheckBox fx:id="chkEstacionamiento" text="Con estacionamiento" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        <CheckBox fx:id="chkPatio" text="Tiene patio" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Guardar" onAction="#guardar"/>
        <Button text="Volver" onAction="#volver"/>
    </HBox>

    <Label fx:id="lblMensaje"/>
</VBox>
